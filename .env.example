# Example for the planned 64-core / 512 GB Ubuntu 24.04 server.
# Copy to .env. Shell variables override these values. Paths are relative to the repo.

# Download originals from Geofabrik and renumber them on this server.
# Use a YYMMDD snapshot available for BOTH Europe and DACH; avoid rolling -latest.
# Leave empty to use renumbered files you supply manually.
GEOFABRIK_DATE=260910

# Optional path overrides. Empty uses osm/<region>-<date>-renumbered.osm.pbf;
# original downloads and their .md5 files are kept beside the renumbered files.
EUROPE_INPUT=
DACH_INPUT=
NRW_INPUT=

# Optional SHA-256 of the renumbered output, not Geofabrik's original PBF.
# Geofabrik downloads are checked against the published .md5 automatically.
EUROPE_SHA256=
DACH_SHA256=

# A new directory protects existing production tiles. Keep it on a roomy local SSD.
OUTPUT_DIR=tilesets/v4-candidate
THREADS=64
COMPILE_JOBS=16
FAST=true
# Empty means RAM. With disk storage, FAST=true disables automatic sharding;
# FAST=false uses the lower-memory, slower sharded mode.
STORE_DIR=

# Allow setup to install build dependencies with apt (root or passwordless sudo).
INSTALL_SYSTEM_PACKAGES=true

# Usually leave these unset. Setup builds tilemaker here and Tippecanoe in .tools/.
# TILEMAKER=./tilemaker
# TILE_JOIN=./.tools/tippecanoe/tile-join
# TILE_DECODE=./.tools/tippecanoe/tippecanoe-decode
# OSMIUM=osmium
